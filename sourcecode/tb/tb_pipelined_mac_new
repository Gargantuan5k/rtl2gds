// =============================================================================
// Testbench: tb_pipelined_mac
// Tests: dot-product correctness, pipeline latency, back-to-back ops, clear
// =============================================================================
`timescale 1ns/1ps

module tb_pipelined_mac;

    reg        clk, rst_n, valid_in, clear;
    reg  signed [15:0] a, b;
    wire signed [31:0] acc_out;
    wire               valid_out, overflow;

    pipelined_mac dut (
        .clk(clk), .rst_n(rst_n), .valid_in(valid_in), .clear(clear),
        .a(a), .b(b), .acc_out(acc_out), .valid_out(valid_out), .overflow(overflow)
    );

    initial clk = 0;
    always #5 clk = ~clk;

    integer pass_cnt = 0, fail_cnt = 0;
    integer k;

    // Feed N mac operations: arrays a_arr, b_arr of length n
    // then wait for valid_out and check against expected
    task run_mac_sequence;
        input integer n;
        input signed [31:0] expected;
        reg signed [31:0] ref_sum;
        integer j;
        begin
            ref_sum = 0;
            // clear first
            @(negedge clk); clear = 1;
            @(posedge clk); #1; clear = 0;

            for (j = 0; j < n; j = j + 1) begin
                // a, b set externally before calling — use internal regs
                @(negedge clk); valid_in = 1;
                @(posedge clk); #1;
            end
            valid_in = 0;
            // drain pipeline (2 stages)
            repeat(3) @(posedge clk);
            #1;
            if (acc_out === expected) begin
                $display("PASS: acc=%0d", acc_out);
                pass_cnt = pass_cnt + 1;
            end else begin
                $display("FAIL: acc=%0d (exp %0d)", acc_out, expected);
                fail_cnt = fail_cnt + 1;
            end
        end
    endtask

    initial begin
        $dumpfile("tb_pipelined_mac.vcd");
        $dumpvars(0, tb_pipelined_mac);

        rst_n = 0; valid_in = 0; clear = 0; a = 0; b = 0;
        repeat(4) @(posedge clk); rst_n = 1;

        // Test 1: single MAC 3*5=15
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;
        a = 16'sd3; b = 16'sd5;
        @(negedge clk); valid_in = 1;
        @(posedge clk); #1; valid_in = 0;
        repeat(4) @(posedge clk); #1;
        if (acc_out === 32'sd15) begin
            $display("PASS: 3*5=%0d", acc_out); pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: 3*5, got %0d", acc_out); fail_cnt = fail_cnt + 1;
        end

        // Test 2: dot product [1,2,3]·[4,5,6] = 4+10+18 = 32
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;

        @(negedge clk); a = 16'sd1; b = 16'sd4; valid_in = 1;
        @(posedge clk); #1;
        @(negedge clk); a = 16'sd2; b = 16'sd5;
        @(posedge clk); #1;
        @(negedge clk); a = 16'sd3; b = 16'sd6;
        @(posedge clk); #1;
        valid_in = 0;
        repeat(4) @(posedge clk); #1;
        if (acc_out === 32'sd32) begin
            $display("PASS: dot[1,2,3]·[4,5,6]=%0d", acc_out); pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: dot product, got %0d", acc_out); fail_cnt = fail_cnt + 1;
        end

        // Test 3: 9-element dot product (3x3 conv kernel)
        // pixels=1..9, weights=1..9, sum = 1+4+9+16+25+36+49+64+81 = 285
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;
        begin : blk
            integer p;
            for (p = 1; p <= 9; p = p + 1) begin
                @(negedge clk);
                a = p[15:0]; b = p[15:0]; valid_in = 1;
                @(posedge clk); #1;
            end
        end
        valid_in = 0;
        repeat(4) @(posedge clk); #1;
        if (acc_out === 32'sd285) begin
            $display("PASS: 9-elem sum of squares=%0d", acc_out); pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: 9-elem, got %0d", acc_out); fail_cnt = fail_cnt + 1;
        end

        // Test 4: negative values [-1,-2]·[3,4] = -3-8 = -11
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;
        @(negedge clk); a = -16'sd1; b = 16'sd3; valid_in = 1;
        @(posedge clk); #1;
        @(negedge clk); a = -16'sd2; b = 16'sd4;
        @(posedge clk); #1;
        valid_in = 0;
        repeat(4) @(posedge clk); #1;
        if (acc_out === -32'sd11) begin
            $display("PASS: neg dot=-11, got %0d", acc_out); pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: neg dot, got %0d", acc_out); fail_cnt = fail_cnt + 1;
        end

        // =====================================================================
        // NEW: Gap #1 -- Overflow was never exercised through the full
        // pipeline (booth_multiplier -> accumulator). Drive two large-magnitude
        // products of the same sign so the accumulator wraps, and confirm the
        // overflow flag rises at the pipelined_mac boundary.
        // =====================================================================
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;
        // 30000 * 30000 = 900,000,000 (fits in 32 bits, no overflow yet)
        a = 16'sd30000; b = 16'sd30000;
        @(negedge clk); valid_in = 1;
        @(posedge clk); #1;
        // Second MAC of the same magnitude: 900,000,000 + 900,000,000 = 1.8e9
        // still fits (< 2^31-1 ~ 2.147e9); do a third to force the wrap.
        @(negedge clk);
        @(posedge clk); #1;
        @(negedge clk);
        @(posedge clk); #1; // 3rd product now landing: total ~2.7e9 -> overflow
        valid_in = 0;
        repeat(4) @(posedge clk); #1;
        if (overflow === 1'b1) begin
            $display("PASS: pipelined_mac overflow flag asserts on accumulator wrap");
            pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: pipelined_mac overflow flag did not assert, acc=%0d ov=%0b",
                      acc_out, overflow);
            fail_cnt = fail_cnt + 1;
        end

        // =====================================================================
        // NEW: Gap #2 -- No test of a pause mid-stream.
        // Run a 3-element dot product but leave a one-cycle bubble (valid_in=0)
        // between the 2nd and 3rd element. The final accumulated result must
        // be identical to the unbroken case (Test 2 above: [1,2,3]-[4,5,6]=32).
        // =====================================================================
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;

        @(negedge clk); a = 16'sd1; b = 16'sd4; valid_in = 1;
        @(posedge clk); #1;
        @(negedge clk); a = 16'sd2; b = 16'sd5;
        @(posedge clk); #1;
        // --- bubble: pause for one cycle before the last element ---
        @(negedge clk); valid_in = 0; a = 16'shDEAD; b = 16'shBEEF;
        @(posedge clk); #1;
        @(negedge clk); a = 16'sd3; b = 16'sd6; valid_in = 1;
        @(posedge clk); #1;
        valid_in = 0;
        repeat(4) @(posedge clk); #1;
        if (acc_out === 32'sd32) begin
            $display("PASS: pipelined_mac dot product correct across a mid-stream bubble");
            pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: bubble corrupted dot product, got %0d (expected 32)", acc_out);
            fail_cnt = fail_cnt + 1;
        end

        // =====================================================================
        // NEW: Gap #3 -- No test of resetting mid-operation.
        // Start a dot product, reset asynchronously partway through, verify
        // the pipeline (both multiplier and accumulator) comes back cleanly
        // to zero and a fresh operation afterward is correct.
        // =====================================================================
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;
        @(negedge clk); a = 16'sd50; b = 16'sd50; valid_in = 1;
        @(posedge clk); #1; // first product (2500) now in flight toward acc
        @(negedge clk); a = 16'sd20; b = 16'sd20;
        #2; rst_n = 0; // async reset while pipeline has in-flight data
        @(posedge clk); #1;
        if (acc_out === 32'sd0 && valid_out === 1'b0 && overflow === 1'b0) begin
            $display("PASS: mid-operation reset clears pipelined_mac state");
            pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: mid-operation reset left stale state, acc=%0d valid=%0b ov=%0b",
                      acc_out, valid_out, overflow);
            fail_cnt = fail_cnt + 1;
        end
        valid_in = 0;
        @(negedge clk); rst_n = 1;
        repeat(2) @(posedge clk); #1;

        // fresh operation after reset release: 4*4 = 16
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;
        @(negedge clk); a = 16'sd4; b = 16'sd4; valid_in = 1;
        @(posedge clk); #1; valid_in = 0;
        repeat(4) @(posedge clk); #1;
        if (acc_out === 32'sd16) begin
            $display("PASS: pipelined_mac resumes normal operation after mid-op reset");
            pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: post-reset MAC wrong, got %0d (expected 16)", acc_out);
            fail_cnt = fail_cnt + 1;
        end

        // =====================================================================
        // NEW: Gap #4 -- No test of overlapping/colliding operations.
        // Issue a new `clear` (start of the next accumulation) WHILE the
        // previous operation's product is still draining through the
        // multiplier's pipeline register. This is exactly the "new op starts
        // before the old one finished" scenario, and it stresses the 1-cycle
        // clear_d1 alignment against in-flight data.
        // =====================================================================
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;
        // Kick off a MAC (5*5=25) but do NOT wait for it to drain...
        @(negedge clk); a = 16'sd5; b = 16'sd5; valid_in = 1;
        @(posedge clk); #1; // product=25 now latched in booth stage, not yet accumulated
        valid_in = 0;
        // ...immediately start a new operation's clear while old data is in flight
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;
        // Now begin the new operation's real data: 6*6=36
        @(negedge clk); a = 16'sd6; b = 16'sd6; valid_in = 1;
        @(posedge clk); #1; valid_in = 0;
        repeat(4) @(posedge clk); #1;
        // Expected: the overlapping clear should fully reset the accumulator
        // before the old in-flight product (25) is captured, so only the new
        // operation's 36 should appear. If clear_d1 timing is off, the old
        // 25 could leak in, giving 61 instead.
        if (acc_out === 32'sd36) begin
            $display("PASS: overlapping clear/new-op correctly discards stale in-flight product");
            pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: overlapping operation corrupted result, got %0d (expected 36 -- stale product may have leaked in)",
                      acc_out);
            fail_cnt = fail_cnt + 1;
        end

        $display("\n=== pipelined_mac: %0d passed, %0d failed ===", pass_cnt, fail_cnt);
        if (fail_cnt == 0) $display("ALL TESTS PASSED");
        $finish;
    end

    initial begin #200000; $display("TIMEOUT"); $finish; end

endmodule
