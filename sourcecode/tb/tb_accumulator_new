// =============================================================================
// Testbench: tb_accumulator
// Tests: basic accumulation, clear, overflow detection, valid gating
// =============================================================================
`timescale 1ns/1ps

module tb_accumulator;

    reg        clk, rst_n, valid_in, clear;
    reg  signed [31:0] data_in;
    wire signed [31:0] acc_out;
    wire               overflow;

    accumulator dut (
        .clk(clk), .rst_n(rst_n), .valid_in(valid_in),
        .clear(clear), .data_in(data_in),
        .acc_out(acc_out), .overflow(overflow)
    );

    initial clk = 0;
    always #5 clk = ~clk;

    integer pass_cnt = 0, fail_cnt = 0;

    task check;
        input signed [31:0] exp_acc;
        input               exp_ov;
        begin
            @(posedge clk); #1;
            if (acc_out === exp_acc && overflow === exp_ov) begin
                $display("PASS: acc=%0d overflow=%0b", acc_out, overflow);
                pass_cnt = pass_cnt + 1;
            end else begin
                $display("FAIL: acc=%0d (exp %0d) overflow=%0b (exp %0b)",
                         acc_out, exp_acc, overflow, exp_ov);
                fail_cnt = fail_cnt + 1;
            end
        end
    endtask

    initial begin
        $dumpfile("tb_accumulator.vcd");
        $dumpvars(0, tb_accumulator);

        rst_n = 0; valid_in = 0; clear = 0; data_in = 0;
        repeat(4) @(posedge clk);
        rst_n = 1; @(posedge clk); #1;

        // Basic accumulation: 10 + 20 + 30 = 60
        @(negedge clk); data_in = 32'sd10; valid_in = 1;
        check(32'sd10, 1'b0);
        @(negedge clk); data_in = 32'sd20;
        check(32'sd30, 1'b0);
        @(negedge clk); data_in = 32'sd30;
        check(32'sd60, 1'b0);
        valid_in = 0;

        // Synchronous clear
        @(negedge clk); clear = 1;
        @(posedge clk); #1;
        clear = 0;
        if (acc_out === 32'sd0) begin
            $display("PASS: clear works"); pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: clear, acc=%0d", acc_out); fail_cnt = fail_cnt + 1;
        end

        // valid_in=0: should not accumulate
        @(negedge clk); data_in = 32'sd999; valid_in = 0;
        @(posedge clk); #1;
        if (acc_out === 32'sd0) begin
            $display("PASS: valid gate works"); pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: valid gate, acc=%0d", acc_out); fail_cnt = fail_cnt + 1;
        end

        // Overflow test: add two large positives
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;
        @(negedge clk); data_in = 32'sh7FFF_FFFF; valid_in = 1;
        check(32'sh7FFF_FFFF, 1'b0);
        @(negedge clk); data_in = 32'sd1;
        @(posedge clk); #1;
        if (overflow === 1'b1) begin
            $display("PASS: overflow detected"); pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: overflow not detected"); fail_cnt = fail_cnt + 1;
        end
        valid_in = 0;

        // =====================================================================
        // NEW: Gap #1 -- Overflow is barely tested. Add negative-direction
        // overflow, boundary (no false trip), and non-sticky de-assertion.
        // =====================================================================

        // --- 1a: Negative overflow (two large negatives wrap to positive) ---
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;
        @(negedge clk); data_in = 32'sh8000_0000; valid_in = 1; // most-negative
        check(32'sh8000_0000, 1'b0);
        @(negedge clk); data_in = -32'sd1; // push further negative -> wraps positive
        @(posedge clk); #1;
        if (overflow === 1'b1) begin
            $display("PASS: negative-direction overflow detected"); pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: negative-direction overflow NOT detected"); fail_cnt = fail_cnt + 1;
        end
        valid_in = 0;

        // --- 1b: Boundary case -- max positive + 0 must NOT falsely overflow ---
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;
        @(negedge clk); data_in = 32'sh7FFF_FFFF; valid_in = 1;
        check(32'sh7FFF_FFFF, 1'b0);
        @(negedge clk); data_in = 32'sd0; // adding 0 must never overflow
        @(posedge clk); #1;
        if (overflow === 1'b0 && acc_out === 32'sh7FFF_FFFF) begin
            $display("PASS: boundary add (+0) does not falsely trip overflow"); pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: boundary add falsely overflowed, acc=%0d ov=%0b", acc_out, overflow);
            fail_cnt = fail_cnt + 1;
        end
        valid_in = 0;

        // --- 1c: overflow flag is NOT sticky -- must clear on next good add ---
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;
        @(negedge clk); data_in = 32'sh7FFF_FFFF; valid_in = 1;
        @(posedge clk); #1;
        @(negedge clk); data_in = 32'sd1; // forces overflow
        @(posedge clk); #1;
        if (overflow !== 1'b1) begin
            $display("FAIL: setup for sticky-check did not overflow as expected");
            fail_cnt = fail_cnt + 1;
        end
        @(negedge clk); clear = 1; valid_in = 0;
        @(posedge clk); #1; clear = 0;
        @(negedge clk); data_in = 32'sd5; valid_in = 1; // ordinary, non-overflowing add
        @(posedge clk); #1;
        if (overflow === 1'b0 && acc_out === 32'sd5) begin
            $display("PASS: overflow flag de-asserts after a clean add (not sticky)");
            pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: overflow flag stuck high or wrong acc, acc=%0d ov=%0b", acc_out, overflow);
            fail_cnt = fail_cnt + 1;
        end
        valid_in = 0;

        // =====================================================================
        // NEW: Gap #2 -- No test of a pause / bubble mid-stream.
        // Insert an idle cycle (valid_in=0) in the middle of a running
        // accumulation and confirm the value holds, then resumes correctly.
        // =====================================================================
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;
        @(negedge clk); data_in = 32'sd7; valid_in = 1;
        check(32'sd7, 1'b0);
        // --- bubble: deassert valid_in for one cycle, acc must hold ---
        @(negedge clk); valid_in = 0; data_in = 32'sdx; // garbage on the bus during the bubble
        @(posedge clk); #1;
        if (acc_out === 32'sd7) begin
            $display("PASS: accumulator holds value during mid-stream bubble");
            pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: accumulator changed during bubble, acc=%0d", acc_out);
            fail_cnt = fail_cnt + 1;
        end
        // --- resume streaming after the gap ---
        @(negedge clk); data_in = 32'sd13; valid_in = 1;
        check(32'sd20, 1'b0); // 7 + 13
        valid_in = 0;

        // =====================================================================
        // NEW: Gap #3 -- No test of resetting mid-operation.
        // Assert rst_n asynchronously WHILE an accumulation is in flight and
        // confirm the accumulator recovers cleanly rather than latching state
        // or getting stuck.
        // =====================================================================
        @(negedge clk); clear = 1;
        @(posedge clk); #1; clear = 0;
        @(negedge clk); data_in = 32'sd100; valid_in = 1;
        check(32'sd100, 1'b0);
        @(negedge clk); data_in = 32'sd50; // still mid-stream, valid_in still 1
        // Assert async reset partway through this cycle, before the clock edge lands
        #2; rst_n = 0;
        @(posedge clk); #1; // reset should win combinationally (async, negedge rst_n)
        if (acc_out === 32'sd0 && overflow === 1'b0) begin
            $display("PASS: mid-operation reset clears acc/overflow immediately");
            pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: mid-operation reset did not clear state, acc=%0d ov=%0b",
                      acc_out, overflow);
            fail_cnt = fail_cnt + 1;
        end
        // release reset and confirm the design comes back to life normally
        valid_in = 0;
        @(negedge clk); rst_n = 1;
        repeat(2) @(posedge clk); #1;
        @(negedge clk); data_in = 32'sd9; valid_in = 1;
        check(32'sd9, 1'b0);
        valid_in = 0;
        $display("PASS: accumulator resumes normal operation after mid-op reset release");
        pass_cnt = pass_cnt + 1;

        // =====================================================================
        // NEW: Gap #4 (collision case) -- clear and valid_in asserted in the
        // SAME cycle. Per the RTL priority (clear checked before valid_in),
        // clear must win and the incoming data_in must be dropped.
        // =====================================================================
        @(negedge clk); clear = 0; valid_in = 0;
        @(posedge clk); #1;
        @(negedge clk); data_in = 32'sd77; valid_in = 1;
        @(posedge clk); #1; // acc_out = 77 now
        @(negedge clk); clear = 1; valid_in = 1; data_in = 32'sd999; // collide
        @(posedge clk); #1;
        clear = 0; valid_in = 0;
        if (acc_out === 32'sd0) begin
            $display("PASS: clear correctly wins over simultaneous valid_in");
            pass_cnt = pass_cnt + 1;
        end else begin
            $display("FAIL: clear/valid_in collision mishandled, acc=%0d", acc_out);
            fail_cnt = fail_cnt + 1;
        end

        $display("\n=== accumulator: %0d passed, %0d failed ===", pass_cnt, fail_cnt);
        if (fail_cnt == 0) $display("ALL TESTS PASSED");
        $finish;
    end

    initial begin #50000; $display("TIMEOUT"); $finish; end

endmodule
